# Copy to .env (gitignored). Only the variable names below are read; keys are never written anywhere.

# OpenAI (gpt4o-mini backbone and the text-embedding-3-small embedder)
OPENAI_API_KEY=

# Self-hosted OpenAI-compatible server (qwen backbone), e.g. vLLM: http://host:8000/v1
QWEN_API_BASE=
QWEN_API_KEY=
# QWEN_MODEL=orcarouter/Qwen3.8-27B-Uncensored-FP8

# Kaggle CLI, for `guide data fetch asap-aes|asap-sas` (or use ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional location overrides (defaults are inside the repo)
# GUIDE_DATA_DIR=./data
# GUIDE_RESULTS_DIR=./results
# GUIDE_CACHE_DIR=./.cache
# GUIDE_DB_PATH=./.cache/service.db
# GUIDE_WORKER_SLOTS=1
# GUIDE_AUTO_RESUME=false
